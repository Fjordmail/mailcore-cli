{
    "name": "inboxcom/mailcore-cli",
    "description": "Command-line interface for the Mailcore mail-server API.",
    "type": "project",
    "license": "MIT",
    "authors": [
        { "name": "Sebastian Karlsen", "email": "sebastian@corp.inbox.com" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../mailcore-php"
        }
    ],
    "require": {
        "php": ">=8.4",
        "inboxcom/mailcore-php": "^0.1",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Inboxcom\\Mailcore\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inboxcom\\Mailcore\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/mailcore"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
