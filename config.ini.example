; Mailcore CLI configuration.
; Copy to ~/.config/mailcore/config.ini (or $XDG_CONFIG_HOME/mailcore/config.ini).
;
; Environment variables (MAILCORE_API_KEY / MAILCORE_BASE_URI) override these.
; Keep this file readable only by you: chmod 600 ~/.config/mailcore/config.ini

api_key  = "your-api-key"

; Optional — defaults to https://api.example.com
;base_uri = "https://api.example.com"
